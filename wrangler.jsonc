{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nome do Worker no Cloudflare (herdado pelo build do Nitro em .output/server/wrangler.json).
  "name": "manual-do-sobrevivente",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // O Nitro sobrescreve este campo no build (aponta para .output/server/index.mjs);
  // mantido aqui apenas para referência do entry de código-fonte do servidor.
  "main": "src/server.ts",
}
