# ============================================================
# Manual do Sobrevivente — variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores.
#   cp .env.example .env
# NUNCA versione o arquivo .env real.
# ============================================================

# --- Supabase (obrigatório) ---
# Painel do projeto: Project Settings > API
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Servidor (usados apenas no lado do servidor / deploy) ---

# Chave service role (bypassa RLS). Só use em ambiente de servidor confiável.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Segredo compartilhado do job agendado de relatórios semanais.
# Deve ser enviado no cabeçalho `Authorization: Bearer <valor>` do job de cron
# que chama POST /api/public/reports-weekly.
# CRON_SECRET="gere-um-segredo-forte-aqui"

# --- Gateway de e-mail (relatório semanal) ---
# Endpoint compatível com a API de envio do Gmail (POST /users/me/messages/send).
# MAIL_GATEWAY_URL="https://seu-gateway/google_mail/gmail/v1"
# MAIL_GATEWAY_KEY="token-bearer-do-gateway"
# MAIL_CONNECTION_KEY="chave-de-conexao-do-gateway"

# --- Modo Osiris (camadas de inteligência global) ---
# Opcional: chave gratuita da NASA FIRMS para a camada "Focos de calor".
# Cadastro em: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Sem a chave, as demais camadas (sismos, eventos, clima espacial) funcionam.
# FIRMS_MAP_KEY="sua-chave-firms"
